          "enable_ptz": "Enable pan/tilt motors",
          "enable_stream": "Enable live video",
          "stream_token": "Stream quality token",
          "ptz_step": "Movement per press",
          "pan_speed": "Pan speed",
          "tilt_speed": "Tilt speed",
          "motion_events": "Enable local motion events"
        }
      }
    }
  },
