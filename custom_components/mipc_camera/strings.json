{
  "config": {
    "step": {
      "user": {
        "title": "Connect to a MIPC camera",
        "description": "Use its local address and Device/Admin PW. Leave the username blank to use its device ID automatically. The MIPC cloud account password does not work here.",
        "data": {
          "host": "Camera address (optional port)",
          "username": "Device username (optional)",
          "password": "Device/Admin PW"
        }
      },
      "reauth_confirm": {
        "title": "Renew camera credentials",
        "description": "Enter the camera Device/Admin PW.",
        "data": {
          "username": "Device username (optional)",
          "password": "Device/Admin PW"
        }
      },
      "reconfigure": {
        "title": "Update the camera connection",
        "data": {
          "host": "Camera address (optional port)",
          "username": "Device username (optional)",
          "password": "Device/Admin PW"
        }
      }
    },
    "error": {
      "invalid_host": "Enter a hostname or IP address, optionally with a port, without a URL scheme or path.",
      "invalid_auth": "The camera rejected the device credentials.",
      "cannot_connect": "Cannot reach the camera.",
      "unknown": "Unexpected camera response.",
      "device_mismatch": "This address belongs to a different camera."
    },
    "abort": {
      "already_configured": "This camera is already configured.",
      "reauth_successful": "Camera credentials updated.",
      "reconfigure_successful": "Camera connection updated."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Camera options",
        "description": "Enable pan/tilt only for cameras with verified motor support. Media connections stay on the configured camera host. Local motion events require the camera motion alarm to be armed. This option does not change camera alarm actions.",
